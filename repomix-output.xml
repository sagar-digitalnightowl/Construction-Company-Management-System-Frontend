    const fetchAllSalarySlips = useCallback(async (params = {}) => {
        setLoading(true);
        try {
            let queryParams = { ...params };
            if (params.month && params.year && !params.month.includes('-')) {
                const monthNames = [
                    "January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"
                ];
                const mIndex = monthNames.indexOf(params.month);
                if (mIndex !== -1) {
                    queryParams.month = `${params.year}-${String(mIndex + 1).padStart(2, '0')}`;
                    delete queryParams.year;
                }
            } else if (params.month && params.year && params.month.includes('-')) {
                delete queryParams.year;
            }

            const res = await hrApi.getAllSalarySlips(queryParams);
            
            // Robust Array Extraction
            let extractedSlips = [];
            if (Array.isArray(res.data?.data)) {
                extractedSlips = res.data.data;
            } else if (Array.isArray(res.data)) {
                extractedSlips = res.data;
            } else if (res.data?.data?.salarySlips) {
                extractedSlips = res.data.data.salarySlips;
            } else if (Array.isArray(res)) {
                extractedSlips = res;
